# API Configuration
VITE_API_BASE_URL=http://localhost:6220

# Google OAuth Configuration
VITE_GOOGLE_CLIENT=your-google-client-id-here

# Authentication URL
VITE_AUTH_URL=https://auth.vjstartup.com

# Debug Mode - Controls visibility of debug features like stage reset buttons and refresh button
# Set to 'true' to enable debug features, 'false' or remove to disable
VITE_DEBUG_MODE=false

# Google Spreadsheet ID or full URL (Team Directory — all worksheets)
VITE_GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id-here

# Optional: Google Sheets API key for faster worksheet discovery
# Falls back to zip-export discovery when not set
VITE_GOOGLE_SHEETS_API_KEY=