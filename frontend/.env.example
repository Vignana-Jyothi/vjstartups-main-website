# Where the site's API lives (backend 2). Baked in at build time.
# Unset: development uses http://localhost:6220 and a production build uses /be on its own domain.
VITE_API_BASE_URL=http://localhost:6220

# The Google client id and the VJOS admin link are NOT set here: the site reads them from the
# backend at runtime (GOOGLE_CLIENT_ID and PLANE_ADMIN_URL in backend/.env), so each is set once.

# Debug Mode - Controls visibility of debug features like stage reset buttons and refresh button
# Set to 'true' to enable debug features, 'false' or remove to disable
VITE_DEBUG_MODE=false

# Optional: a Google Sheet (id or link) to read the club team from instead of the bundled list
# in src/data/clubTeam.ts. The sheet must be viewable by link, so it must hold no emails or phones.
VITE_TEAM_SHEET_ID=

# Optional: Google Sheets API key for faster worksheet discovery of that sheet
# Falls back to zip-export discovery when not set
VITE_GOOGLE_SHEETS_API_KEY=
