// Prisma Schema for VJ Startups Platform
// PostgreSQL Migration from MongoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
//
// User and OrganizationMemberProfile are Django/Plane-owned tables in Plane's
// own Postgres database (merged from what used to be this app's own separate
// database - see the migration in apps/api/plane/vj_startups for the Django
// side). Django remains the sole owner of migrations for both tables.
//
// These two models are READ-ONLY from Prisma's side. Never call
// prisma.user.create/update/upsert/delete or the same on
// organizationMemberProfile - user creation must go through Django's own API
// (see auth-api.js) so it fires Django's onboarding signals (workspace
// membership, profile creation, etc.) and correctly populates the ~35 other
// NOT NULL columns on `users` that belong to Django's own bookkeeping, none
// of which Prisma has any business setting.
//
// Both tables use Django's soft-delete convention (a deletedAt column, no
// hard deletes) - any query against them should filter deletedAt: null,
// since Prisma has no built-in awareness of that convention the way Django's
// own default manager does.
// ============================================================================

model User {
  id          String    @id @db.Uuid
  email       String?   @unique
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  displayName String    @map("display_name")
  avatar      String
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  vjProfile   OrganizationMemberProfile?

  // Relations (still keyed by email - Django's users.email is unique too)
  problemsCreated      Problem[]            @relation("ProblemCreator")
  ideasCreated         Idea[]               @relation("IdeaCreator")
  startupsCreated      Startup[]            @relation("StartupCreator")
  projectsCreated      Project[]            @relation("ProjectCreator")
  tasksCreated         Task[]               @relation("TaskCreator")
  tasksAssigned        Task[]               @relation("TaskAssignee")
  problemUpvotes       ProblemUpvote[]
  ideaUpvotes          IdeaUpvote[]
  problemComments      ProblemComment[]
  ideaComments         IdeaComment[]
  stageNotifications   StageNotification[]
  projectMemberships   ProjectMember[]

  @@map("users")
}

// The public site's former User.role/adminToken/sessionToken now live here -
// see OrganizationMemberProfile.public_role etc. on the Django side. This is
// the public site's own permission level, distinct from Plane's own
// workspace roles/InstanceAdmin.
model OrganizationMemberProfile {
  id                           String    @id @db.Uuid
  userId                       String    @unique @map("user_id") @db.Uuid
  publicRole                   String    @default("STUDENT") @map("public_role")
  publicAdminToken             String?   @unique @map("public_admin_token")
  publicAdminTokenCreatedAt    DateTime? @map("public_admin_token_created_at")
  publicSessionToken           String?   @unique @map("public_session_token")
  publicSessionTokenCreatedAt  DateTime? @map("public_session_token_created_at")
  deletedAt                    DateTime? @map("deleted_at")

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vj_organization_member_profiles")
}

// ============================================================================
// PROBLEMS
// ============================================================================

model Problem {
  id                   String             @id @default(uuid())
  problemId            String             @unique  // Legacy sequential string ID
  title                String
  briefparagraph       String             @db.Text
  description          String?            @db.Text
  marketSize           String?            @db.Text
  existingSolutions    String?            @db.Text
  currentGaps          String?            @db.Text
  targetCustomers      String?            @db.Text
  image                String?
  upvotes              Int                @default(0)
  background           String?            @db.Text
  scalability          String?            @db.Text
  addedByName          String
  addedByEmail         String
  tags                 String[]           @default([])
  verified             Boolean            @default(false)
  verifiedBy           String?
  verifiedAt           DateTime?
  verificationNotes    String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  creator              User               @relation("ProblemCreator", fields: [addedByEmail], references: [email])
  collaborators        ProblemCollaborator[]
  comments             ProblemComment[]
  upvotedBy            ProblemUpvote[]
  ideas                Idea[]

  @@index([problemId])
  @@index([addedByEmail])
  @@index([createdAt])
  @@index([verified])
  @@map("problems")
}

model ProblemCollaborator {
  id         String   @id @default(uuid())
  problemId  String
  email      String
  createdAt  DateTime @default(now())

  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, email])
  @@index([problemId])
  @@index([email])
  @@map("problem_collaborators")
}

model ProblemUpvote {
  id         String   @id @default(uuid())
  problemId  String
  userEmail  String
  createdAt  DateTime @default(now())

  problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@unique([problemId, userEmail])
  @@index([problemId])
  @@index([userEmail])
  @@map("problem_upvotes")
}

model ProblemComment {
  id         String             @id @default(uuid())
  commentId  String             @unique  // Legacy field
  problemId  String
  text       String             @db.Text
  name       String
  email      String
  likes      Int                @default(0)
  createdAt  DateTime           @default(now())

  problem    Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [email], references: [email], onDelete: Cascade)
  likedBy    ProblemCommentLike[]
  replies    ProblemCommentReply[]

  @@index([problemId])
  @@index([email])
  @@index([createdAt])
  @@map("problem_comments")
}

model ProblemCommentLike {
  id        String         @id @default(uuid())
  commentId String
  userEmail String
  createdAt DateTime       @default(now())

  comment   ProblemComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userEmail])
  @@index([commentId])
  @@map("problem_comment_likes")
}

model ProblemCommentReply {
  id        String         @id @default(uuid())
  replyId   String         @unique  // Legacy field
  commentId String
  text      String         @db.Text
  name      String
  email     String
  likes     Int            @default(0)
  createdAt DateTime       @default(now())

  comment   ProblemComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likedBy   ProblemReplyLike[]

  @@index([commentId])
  @@index([createdAt])
  @@map("problem_comment_replies")
}

model ProblemReplyLike {
  id        String              @id @default(uuid())
  replyId   String
  userEmail String
  createdAt DateTime            @default(now())

  reply     ProblemCommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userEmail])
  @@index([replyId])
  @@map("problem_reply_likes")
}

// ============================================================================
// IDEAS
// ============================================================================

model Idea {
  id                  String               @id @default(uuid())
  ideaId              String               @unique  // UUID from MongoDB
  title               String
  description         String               @db.Text
  titleImage          String?
  relatedProblemId    String?
  stage               Int                  @default(1)
  upvotes             Int                  @default(0)
  mentor              String?
  contact             String?
  addedByName         String
  addedByEmail        String
  tags                String[]             @default([])
  targetCustomers     String?              @db.Text
  verified            Boolean              @default(false)
  verifiedBy          String?
  verifiedAt          DateTime?
  verificationNotes   String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Startup worthiness
  isStartupWorthy     Boolean              @default(false)
  worthinessLevel     WorthinessLevel?
  evaluatedAt         DateTime?
  hasStartupCreated   Boolean              @default(false)

  // Relations
  creator             User                 @relation("IdeaCreator", fields: [addedByEmail], references: [email])
  problem             Problem?             @relation(fields: [relatedProblemId], references: [problemId])
  collaborators       IdeaCollaborator[]
  teamMembers         IdeaTeamMember[]
  comments            IdeaComment[]
  upvotedBy           IdeaUpvote[]
  attachments         IdeaAttachment[]
  links               IdeaLink[]
  questionnaires      QuestionnaireResponse[]
  stageNotifications  StageNotification[]

  @@index([ideaId])
  @@index([addedByEmail])
  @@index([relatedProblemId])
  @@index([stage])
  @@index([createdAt])
  @@index([verified])
  @@map("ideas")
}

enum WorthinessLevel {
  HIGH
  MEDIUM
  LOW

  @@map("worthiness_level")
}

model IdeaCollaborator {
  id        String   @id @default(uuid())
  ideaId    String
  email     String
  createdAt DateTime @default(now())

  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, email])
  @@index([ideaId])
  @@index([email])
  @@map("idea_collaborators")
}

model IdeaTeamMember {
  id        String   @id @default(uuid())
  ideaId    String
  name      String
  email     String?
  role      String
  image     String?
  createdAt DateTime @default(now())

  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_team_members")
}

model IdeaUpvote {
  id        String   @id @default(uuid())
  ideaId    String
  userEmail String
  createdAt DateTime @default(now())

  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@unique([ideaId, userEmail])
  @@index([ideaId])
  @@index([userEmail])
  @@map("idea_upvotes")
}

model IdeaComment {
  id        String           @id @default(uuid())
  commentId String           @unique  // Legacy UUID
  ideaId    String
  author    String
  content   String           @db.Text
  email     String
  createdAt DateTime         @default(now())

  idea      Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [email], references: [email], onDelete: Cascade)
  likes     IdeaCommentLike[]
  replies   IdeaCommentReply[]

  @@index([ideaId])
  @@index([email])
  @@index([createdAt])
  @@map("idea_comments")
}

model IdeaCommentLike {
  id        String      @id @default(uuid())
  commentId String
  userEmail String
  createdAt DateTime    @default(now())

  comment   IdeaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userEmail])
  @@index([commentId])
  @@map("idea_comment_likes")
}

model IdeaCommentReply {
  id        String              @id @default(uuid())
  replyId   String              @unique  // Legacy UUID
  commentId String
  author    String
  content   String              @db.Text
  email     String
  createdAt DateTime            @default(now())

  comment   IdeaComment         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  likes     IdeaReplyLike[]

  @@index([commentId])
  @@index([createdAt])
  @@map("idea_comment_replies")
}

model IdeaReplyLike {
  id        String           @id @default(uuid())
  replyId   String
  userEmail String
  createdAt DateTime         @default(now())

  reply     IdeaCommentReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([replyId, userEmail])
  @@index([replyId])
  @@map("idea_reply_likes")
}

model IdeaAttachment {
  id          String   @id @default(uuid())
  ideaId      String
  name        String
  url         String
  type        String
  size        String
  accessLevel AccessLevel @default(PUBLIC)
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([accessLevel])
  @@map("idea_attachments")
}

model IdeaLink {
  id          String      @id @default(uuid())
  ideaId      String
  title       String
  url         String
  description String?     @db.Text
  accessLevel AccessLevel @default(PUBLIC)
  addedBy     String
  addedAt     DateTime    @default(now())

  idea        Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([accessLevel])
  @@map("idea_links")
}

enum AccessLevel {
  PUBLIC
  PRIVATE

  @@map("access_level")
}

// ============================================================================
// STARTUPS
// ============================================================================

// Startup, StartupTeamMember and StartupSupportProgram are Django/Plane-owned
// tables too (see the note above OrganizationMemberProfile) - same rules
// apply: Django owns migrations, filter deletedAt: null, and this model can
// be written to directly since every field here is plain business data
// Prisma fully understands (unlike User's Django-internal bookkeeping
// columns). createdById/updatedById mirror Django's audit convention - set
// them explicitly when creating/updating from backend-2 if you have the
// acting user's id, otherwise they're left null.
//
// There's no formal Prisma relation to Idea here even though
// relatedIdeaId/ideaId conceptually link them: enforcing it would require a
// migration that adds an FK constraint onto this Django-owned table, which
// crosses the ownership boundary. Look the Idea up manually by ideaId
// instead of using `include`.
model Startup {
  id                   String                  @id @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at")
  deletedAt            DateTime?               @map("deleted_at")
  createdById          String?                 @map("created_by_id") @db.Uuid
  updatedById          String?                 @map("updated_by_id") @db.Uuid

  name                 String                  @map("name")
  slug                 String                  @unique
  tagline              String                  @default("")
  description          String                  @default("") @db.Text
  logo                 String                  @default("")
  coverImage           String                  @default("") @map("cover_image")
  foundersText         String                  @default("") @map("founders_text")
  trlStage             Int                     @default(1) @map("trl_stage")
  fundingStatus        String                  @default("") @map("funding_status")
  incorporationStatus  String                  @default("") @map("incorporation_status")
  financialNotes       String                  @default("") @map("financial_notes")
  revenue              Decimal                 @default(0) @db.Decimal(12, 2)
  fundingRaised        Decimal                 @default(0) @map("funding_raised") @db.Decimal(15, 2)
  customers            String                  @default("")
  markets              String                  @default("")
  website              String                  @default("")
  businessModel        String                  @default("") @map("business_model")
  keyFeatures          Json                    @default("[]") @map("key_features")
  technologyStack      Json                    @default("[]") @map("technology_stack")
  marketSize           String                  @default("") @map("market_size")
  annualGrowthRate     String                  @default("") @map("annual_growth_rate")
  targetUsers          String                  @default("") @db.Text @map("target_users")
  teamSize             Int                     @default(1) @map("team_size")
  pitchDeckUrl          String                 @default("") @map("pitch_deck_url")
  onePagerUrl          String                  @default("") @map("one_pager_url")
  githubUrl            String                  @default("") @map("github_url")
  upvotes              Int                     @default(0)
  views                Int                     @default(0)
  userCount            Int                     @default(0) @map("users")
  problemStatement     String                  @default("") @db.Text @map("problem_statement")
  solutionStatement    String                  @default("") @db.Text @map("solution_statement")
  targetAudience       String                  @default("") @db.Text @map("target_audience")
  competitiveAdvantage String                  @default("") @db.Text @map("competitive_advantage")
  industry             String                  @default("")
  status               String                  @default("active")
  publicVisibility     Boolean                 @default(false) @map("public_visibility")
  foundedDate          DateTime?               @map("founded_date") @db.Date
  invitedEmails        Json                    @default("[]") @map("invited_emails")
  ideaId               String?                 @unique @map("related_idea_id")

  creator              User?                   @relation("StartupCreator", fields: [createdById], references: [id])
  teamMembers          StartupTeamMember[]
  supportPrograms      StartupSupportProgram[]
  milestones           Milestone[]

  @@index([ideaId])
  @@index([trlStage])
  @@index([createdAt])
  @@map("vj_startups")
}

model StartupTeamMember {
  id          String    @id @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  startupId   String    @map("startup_id") @db.Uuid
  name        String
  role        String
  avatar      String    @default("")

  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("vj_startup_team_members")
}

model StartupSupportProgram {
  id          String    @id @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  startupId   String    @map("startup_id") @db.Uuid
  program     String

  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("vj_startup_support_programs")
}

// Replaces the old StartupMilestone - Plane already had a Milestone model
// that's a strict superset (also auto-populated from completed project work
// via a Django signal), so this maps onto that instead of a new table.
// completed (from the old StartupMilestone shape) is derived as
// achievedAt !== null rather than stored separately.
model Milestone {
  id          String    @id @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  startupId   String    @map("startup_id") @db.Uuid
  title       String
  description String    @default("") @db.Text
  type        String    @default("manual")
  achievedAt  DateTime? @map("achieved_at")
  metadata    Json      @default("{}")

  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([achievedAt])
  @@map("vj_milestones")
}

// ============================================================================
// QUESTIONNAIRES
// ============================================================================

model QuestionnaireResponse {
  id               String                    @id @default(uuid())
  responseId       String                    @unique  // Legacy field
  userId           String?
  userEmail        String
  userName         String?
  ideaId           String
  stageFrom        Int
  stageTo          Int
  responses        Json                      // Dynamic responses
  overallScore     Int?
  status           QuestionnaireStatus       @default(DRAFT)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  // Relations
  idea             Idea                      @relation(fields: [ideaId], references: [ideaId])
  scores           QuestionnaireScore[]
  recommendations  QuestionnaireRecommendation[]
  worthinessCriteria QuestionnaireCriteria[]

  @@index([ideaId])
  @@index([userEmail])
  @@index([createdAt])
  @@map("questionnaire_responses")
}

enum QuestionnaireStatus {
  DRAFT
  COMPLETED

  @@map("questionnaire_status")
}

model QuestionnaireScore {
  id                    String                 @id @default(uuid())
  questionnaireId       String
  problemClarity        Int?
  marketPotential       Int?
  solutionViability     Int?
  competitivePosition   Int?
  executionReadiness    Int?

  questionnaire         QuestionnaireResponse  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId])
  @@map("questionnaire_scores")
}

model QuestionnaireRecommendation {
  id              String                 @id @default(uuid())
  questionnaireId String
  recommendation  String                 @db.Text

  questionnaire   QuestionnaireResponse  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@map("questionnaire_recommendations")
}

model QuestionnaireCriteria {
  id                        String                 @id @default(uuid())
  questionnaireId           String
  revenueModelValidated     Boolean                @default(false)
  customerWillingnessToPay  Boolean                @default(false)
  marketValidation          Boolean                @default(false)
  revenueGenerated          Boolean                @default(false)
  technicalReadiness        Boolean                @default(false)
  customerBase              Boolean                @default(false)
  scalabilityPlan           Boolean                @default(false)
  metCriteria               Int                    @default(0)
  totalCriteria             Int                    @default(7)
  isStartupWorthy           Boolean                @default(false)
  worthinessLevel           WorthinessLevel?

  questionnaire             QuestionnaireResponse  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([questionnaireId])
  @@map("questionnaire_criteria")
}

// ============================================================================
// PROJECTS & TASKS (Plane Board)
// ============================================================================

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?         @db.Text
  color       String          @default("#7c3aed")
  emoji       String          @default("📋")
  status      ProjectStatus   @default(ACTIVE)
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  creator     User            @relation("ProjectCreator", fields: [createdBy], references: [email])
  members     ProjectMember[]
  tasks       Task[]

  @@index([createdBy])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  name      String
  email     String
  picture   String?
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

enum ProjectMemberRole {
  MEMBER
  LEAD

  @@map("project_member_role")
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(NONE)
  projectId      String
  assigneeUserId String?
  assigneeName   String?
  assigneePicture String?
  labels         String[]     @default([])
  dueDate        DateTime?
  order          Int          @default(0)
  createdByUserId String
  createdByName  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User         @relation("TaskCreator", fields: [createdByUserId], references: [id])
  assignee       User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  comments       TaskComment[]

  @@index([projectId, status])
  @@index([projectId, order])
  @@index([assigneeUserId])
  @@index([createdByUserId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE

  @@map("task_status")
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE

  @@map("task_priority")
}

model TaskComment {
  id            String   @id @default(uuid())
  taskId        String
  content       String   @db.Text
  authorId      String
  authorName    String
  authorPicture String?
  createdAt     DateTime @default(now())

  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
  @@map("task_comments")
}

// ============================================================================
// ANNOUNCEMENTS
// ============================================================================

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  postedByName String
  postedByEmail String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
  @@index([createdAt])
  @@map("announcements")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model StageNotification {
  id            String   @id @default(uuid())
  ideaId        String
  ideaTitle     String
  userEmail     String
  userName      String?
  userAvatar    String?
  previousStage Int
  newStage      Int
  stageName     String
  stageType     StageType @default(IDEA)
  createdAt     DateTime @default(now())
  expiresAt     DateTime // Auto-delete after 30 days

  // Relations
  idea          Idea     @relation(fields: [ideaId], references: [ideaId])
  user          User     @relation(fields: [userEmail], references: [email])

  @@index([ideaId, createdAt])
  @@index([userEmail, createdAt])
  @@index([createdAt])
  @@index([expiresAt]) // For TTL functionality
  @@map("stage_notifications")
}

enum StageType {
  PROBLEM
  IDEA
  STARTUP

  @@map("stage_type")
}
