# PostgreSQL Connection - this backend's own tables (Problem, Idea, Comment,
# etc.) now live in Plane's own database, not a separate one. Use the same
# Postgres instance/credentials Plane's apps/api/.env (POSTGRES_*) uses, with
# Plane's database name. User/OrganizationMemberProfile/Startup are
# Django-owned tables in that same database - see the notes above those
# models in prisma/schema.prisma before changing anything about them.
DATABASE_URL=postgresql://username:password@localhost:5432/plane?schema=public

# Server Configuration
PORT=6220

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Comma-separated list of emails that should be auto-promoted to admin on login
ADMIN_EMAILS=[abcd1@gmail.com, abcd2@gmail.com]

# Plane's API base URL and the shared secret for calling its internal
# user-upsert endpoint (public-auth/upsert-user/) on Google login. This value
# must match PUBLIC_SITE_INTERNAL_TOKEN in Plane's own apps/api/.env exactly.
# Never expose this to a browser - it's server-to-server only.
PLANE_API_URL=http://localhost:8000
PLANE_INTERNAL_TOKEN=

# Cloudinary (image uploads for problem/idea/startup photos). Left blank,
# uploads fail gracefully in local dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=