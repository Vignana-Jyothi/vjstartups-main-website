# PostgreSQL Connection - this backend's own tables (Problem, Idea, Comment,
# etc.) now live in Plane's own database, not a separate one. Use the same
# Postgres instance/credentials Plane's apps/api/.env (POSTGRES_*) uses, with
# Plane's database name. User/OrganizationMemberProfile/Startup are
# Django-owned tables in that same database - see the notes above those
# models in prisma/schema.prisma before changing anything about them.
DATABASE_URL=postgresql://username:password@localhost:5432/plane?schema=public

# Server Configuration
PORT=6220

# Google OAuth. The site's login page reads this from GET /auth/config, so it is the only place
# the client id is set (sign-in tokens are checked against the same value).
GOOGLE_CLIENT_ID=your_google_client_id

# Comma-separated list of emails that should be auto-promoted to admin on login
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Optional. VJOS's admin page, linked from the site's nav for admins (served to the browser by
# GET /auth/config). No link when unset.
# PLANE_ADMIN_URL=http://localhost:3001/god-mode/

# Required settings (DATABASE_URL, GOOGLE_CLIENT_ID, PLANE_API_URL, PLANE_INTERNAL_TOKEN and the
# three CLOUDINARY_* values) have no built-in defaults: the server names any that are missing in
# its start-up log, and the routes that need them answer "not set up" instead of guessing.

# Plane's API base URL and the shared secret for calling its internal
# user-upsert endpoint (public-auth/upsert-user/) on Google login. This value
# must match PUBLIC_SITE_INTERNAL_TOKEN in Plane's own apps/api/.env exactly.
# Never expose this to a browser - it's server-to-server only.
PLANE_API_URL=http://localhost:8000
PLANE_INTERNAL_TOKEN=

# Optional. Comma-separated email domains treated as the college's (used to
# accept problem collaborators). Default: vnrvjiet.in
# INSTITUTIONAL_EMAIL_DOMAINS=vnrvjiet.in
# Optional. Comma-separated browser origins allowed by CORS; replaces the built-in
# list (the live/dev sites, plus localhost when NODE_ENV is not production).
# CORS_ORIGINS=https://www.vjstartup.com,https://dev-vj.vjstartup.com

# Cloudinary (image uploads for problem/idea/startup photos). Left blank,
# uploads fail gracefully in local dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=